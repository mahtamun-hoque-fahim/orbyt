# Neon PostgreSQL — pooled connection (used by the app at runtime)
DATABASE_URL=

# Neon PostgreSQL — direct (unpooled) connection (used by drizzle-kit for migrations)
DATABASE_URL_UNPOOLED=

# Better Auth — secret for session signing (generate: openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Better Auth — public URL of the app (no trailing slash)
BETTER_AUTH_URL=

# Public app URL — readable by the browser
NEXT_PUBLIC_APP_URL=

# VAPID public key — readable by the browser (generate: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_KEY=

# VAPID private key — server only, never expose to the client
VAPID_PRIVATE_KEY=

# VAPID contact email — must be a mailto: URI
VAPID_EMAIL=

# Cron secret — used to authenticate Vercel Cron calls to /api/cron/notifications
# Generate any random string, e.g.: openssl rand -hex 32
CRON_SECRET=
